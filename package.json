{
	"name": "@iowarp/clio-coder",
	"version": "0.3.2",
	"description": "Coding agent for HPC and scientific-software developers, part of IOWarp's CLIO ecosystem of agentic science.",
	"keywords": [
		"ai",
		"agentic-ai",
		"agentic-coding",
		"agentic-science",
		"coding",
		"repository",
		"terminal",
		"developer-tools",
		"llm",
		"agents",
		"model-targets",
		"multi-agent",
		"coding-agents",
		"software-engineering",
		"research-software",
		"scientific-computing",
		"hpc",
		"clio",
		"iowarp"
	],
	"type": "module",
	"license": "Apache-2.0",
	"author": "Anthony Kougkas <a.kougkas@gmail.com> (https://github.com/akougkas)",
	"contributors": [
		"IOWarp <https://iowarp.ai>",
		"Gnosis Research Center <https://grc.iit.edu/>"
	],
	"homepage": "https://iowarp.ai",
	"bugs": "https://github.com/iowarp/clio-coder/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iowarp/clio-coder.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"clio-coder": "dist/cli/index.js"
	},
	"exports": {
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"assets/clio-coder-logo-128.webp",
		"src/**",
		"skills/**",
		"docs/*.md",
		"docs/html/**",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"CODE_OF_CONDUCT.md",
		"NOTICE",
		"LICENSE",
		"damage-control-rules.yaml"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup && node --import tsx scripts/build-codewiki-asset.ts",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc -p tsconfig.tests.json",
		"format": "biome format --write .",
		"lint": "biome check . && node --import tsx scripts/check-hygiene.ts",
		"test:file": "node --import tsx --import ./tests/harness/tmp-root.ts --test",
		"pretest": "test -f dist/assets/codewiki.json && [ -z \"$(find src -newer dist/assets/codewiki.json -type f -print -quit)\" ] || npm run build",
		"test": "node scripts/shard-tests.mjs",
		"test:coverage": "node scripts/test-coverage.mjs --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.d.ts' 'tests/contracts/**/*.test.ts' 'tests/smoke/**/*.test.ts'",
		"test:repeat": "node tests/harness/repeat-tests.mjs",
		"test:trace-viewer": "npm --prefix apps/trace-viewer test",
		"trace:ui": "node apps/trace-viewer/server.mjs",
		"ci": "npm run typecheck && npm run lint && npm run skills:check && npm run build && npm run test && npm run test:trace-viewer",
		"ci:release": "npm run ci && node scripts/check-release.mjs",
		"install:local": "bash scripts/install-local.sh",
		"prepublishOnly": "npm run ci:release",
		"skills:pin": "node --import tsx scripts/pin-skills.ts",
		"skills:check": "node --import tsx scripts/pin-skills.ts --check",
		"//": "below here: real providers or a live model target, cost money and/or time, never run in CI",
		"test:live": "node scripts/live-smoke.mjs",
		"test:live-eval": "node scripts/live-eval-recon.mjs",
		"test:live-eval:fleet-dispatch": "node scripts/live-eval-fleet-dispatch.mjs",
		"test:live-verify:dispatch-routing": "node scripts/live-verify-dispatch-routing.mjs",
		"test:lifecycle": "node --import tsx scripts/lifecycle-matrix.mjs",
		"bench:swe": "python3 benchmarks/community/swe-bench-lite/swebench_clio.py",
		"bench:scicode": "python3 benchmarks/community/scicode/scicode_clio.py",
		"bench:tb": "python3 benchmarks/community/clio_fleet.py"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.186",
		"@earendil-works/pi-agent-core": "0.84.0",
		"@earendil-works/pi-ai": "0.84.0",
		"@earendil-works/pi-tui": "0.84.0",
		"@silvia-odwyer/photon-node": "^0.3.4",
		"ollama": "0.6.3"
	},
	"overrides": {
		"@anthropic-ai/sdk": "0.105.0",
		"ip-address": "10.2.0",
		"esbuild": "0.28.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/node": "24.12.2",
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"chalk": "5.6.2",
		"diff": "9.0.0",
		"esbuild": "0.28.1",
		"node-pty": "1.1.0",
		"tree-sitter-wasms": "^0.1.13",
		"tsup": "8.5.1",
		"tsx": "4.22.4",
		"typebox": "1.3.0",
		"typescript": "6.0.3",
		"undici": "8.5.0",
		"uuid": "14.0.1",
		"yaml": "2.9.0"
	}
}
