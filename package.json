{
	"name": "@iowarp/clio-coder",
	"version": "0.7.1",
	"description": "Open-source coding agent for scientific computing and HPC: in your terminal, on the desktop (alpha), headless, and over ACP, with local or cloud models, bounded workers, and inspectable evidence.",
	"keywords": [
		"ai",
		"agentic-ai",
		"agentic-coding",
		"agentic-science",
		"coding",
		"repository",
		"terminal",
		"developer-tools",
		"llm",
		"local-llm",
		"agents",
		"model-targets",
		"multi-agent",
		"coding-agents",
		"coding-agent",
		"ai-coding-agent",
		"cli",
		"tui",
		"ollama",
		"vllm",
		"agent-client-protocol",
		"acp",
		"mcp",
		"software-engineering",
		"research-software",
		"scientific-software",
		"research-computing",
		"scientific-computing",
		"hpc",
		"clio",
		"iowarp"
	],
	"type": "module",
	"license": "Apache-2.0",
	"author": "Anthony Kougkas <a.kougkas@gmail.com> (https://github.com/akougkas)",
	"contributors": [
		"IOWarp <https://iowarp.ai>",
		"Gnosis Research Center <https://grc.iit.edu/>"
	],
	"homepage": "https://coder.iowarp.ai",
	"bugs": "https://github.com/iowarp/clio-coder/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iowarp/clio-coder.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"clio-coder": "bin/clio-coder.cjs"
	},
	"exports": {
		"./package.json": "./package.json",
		"./extensions": {
			"types": "./dist/extensions/public-api.d.ts"
		},
		"./extensions/testing": {
			"types": "./dist/extensions/testing.d.ts",
			"import": "./dist/extensions/testing.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/metafile*.json",
		"bin/clio-coder.cjs",
		"scripts/install.sh",
		"scripts/install.ps1",
		"scripts/install.cmd",
		"scripts/native-install.cjs",
		"!assets/README.md",
		"!scripts/README.md",
		"src/**",
		"tests/fixtures/decision-cases/turn.json",
		"tests/fixtures/decision-cases/worker-prepare.json",
		"tests/fixtures/decision-cases/tool-calls.json",
		"models/**",
		"library/**",
		".claude-plugin/marketplace.json",
		"docs/**/*.md",
		"!docs/wiki/**",
		"docs/corpus.json",
		"assets/clio-mark-gui.webp",
		"assets/windows-launcher/pins.json",
		"assets/windows-launcher/win32-x64/launcher.exe",
		"assets/windows-launcher/win32-arm64/launcher.exe",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"CODE_OF_CONDUCT.md",
		"NOTICE",
		"LICENSE",
		"damage-control-rules.yaml",
		"examples/extensions/**"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node --import tsx scripts/build.ts && node --import tsx scripts/build-source-pack.ts && node --import tsx scripts/build-codewiki-asset.ts",
		"dev": "node --import tsx scripts/build.ts --watch",
		"clean": "rm -rf dist",
		"typecheck": "tsc -p tsconfig.tests.json",
		"format": "biome format --write .",
		"lint": "biome check . && node --import tsx scripts/check-hygiene.ts",
		"pi:surface-diff": "node --import tsx scripts/pi-surface-diff.ts",
		"pi:surface-snapshot": "node --import tsx scripts/pi-surface-diff.ts --write",
		"herdr:pin": "node --import tsx scripts/herdr-pin.ts",
		"test:file": "node --import tsx --import ./tests/harness/tmp-root.ts --test",
		"test": "node scripts/ci-tests.mjs core",
		"test:gui": "node scripts/ci-tests.mjs gui",
		"test:list": "node scripts/ci-tests.mjs list",
		"check:gui": "pnpm --filter @iowarp/clio-coder-gui typecheck && pnpm --filter @iowarp/clio-coder-gui lint",
		"ci": "node scripts/release-candidate.mjs qualify",
		"ci:release": "node scripts/release-candidate.mjs qualify",
		"release:readiness": "node scripts/release-readiness.mjs",
		"release": "node scripts/release.mjs",
		"release:rehearse": "node scripts/release.mjs --rehearse",
		"release:next": "node scripts/release/next.mjs",
		"install:local": "bash scripts/install-local.sh",
		"prepublishOnly": "node -e \"throw new Error('Use pnpm run release; publication requires the approved GitHub release job.')\"",
		"skills:pin": "node --import tsx scripts/pin-skills.ts",
		"skills:check": "node --import tsx scripts/pin-skills.ts --check",
		"hooks:install": "node scripts/git-guard.mjs install",
		"library:pin": "node --import tsx scripts/pin-library.ts",
		"library:check": "node --import tsx scripts/pin-library.ts --check",
		"pretest:full": "node scripts/check-dist.mjs",
		"test:full": "node scripts/ci-tests.mjs full",
		"test:package": "node scripts/ci-tests.mjs package",
		"release:preflight": "node scripts/release-candidate.mjs preflight",
		"test:gui:full": "pnpm --filter @iowarp/clio-coder-gui test:full",
		"eval:onboarding": "node --import tsx scripts/eval-onboarding.ts",
		"test:maintenance": "pnpm run test:file -- tests/extended/keyboard-routing.test.ts tests/extended/keyboard-drafts.test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"grok-mermaid": "0.2.2",
		"minimatch": "11.0.5",
		"smol-toml": "1.9.0",
		"undici": "7.30.2"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.292",
		"@github/copilot-sdk": "1.0.26",
		"@biomejs/biome": "2.5.1",
		"@types/node": "24.12.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vscode/tree-sitter-wasm": "0.3.1",
		"chalk": "5.6.2",
		"diff": "9.0.0",
		"esbuild": "0.28.1",
		"node-pty": "1.1.0",
		"ollama": "0.6.3",
		"tree-sitter-wasms": "0.1.13",
		"tsup": "8.5.1",
		"entities": "7.0.1",
		"marked": "18.0.11",
		"tsx": "4.22.4",
		"typebox": "1.3.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"uuid": "14.0.1",
		"yaml": "2.9.0"
	},
	"packageManager": "pnpm@10.34.5",
	"workspaces": [
		"apps/*"
	]
}
