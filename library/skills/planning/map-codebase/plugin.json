{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "map-codebase",
	"version": "0.2.0",
	"description": "Interactive codebase maps from verified repository structure, symbols and imports, rendered natively as standalone HTML.",
	"license": "Apache-2.0",
	"extensions": {
		"ai.iowarp.clio": {
			"manifestVersion": 1,
			"kind": "skill",
			"resources": {
				"skills": "."
			},
			"components": [
				{
					"kind": "skill",
					"id": "map-codebase",
					"path": "SKILL.md"
				}
			]
		}
	}
}
