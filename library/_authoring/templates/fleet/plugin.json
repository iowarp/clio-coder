{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "pipeline-review",
	"version": "1.0.0",
	"description": "Multi-agent coordination recipe for reviewing scientific data pipelines.",
	"license": "Apache-2.0",
	"extensions": {
		"ai.iowarp.clio": {
			"manifestVersion": 1,
			"kind": "fleet",
			"resources": {
				"fleets": "fleets"
			},
			"components": [
				{
					"kind": "fleet",
					"id": "pipeline-review",
					"path": "fleets/pipeline-review.md"
				}
			]
		}
	}
}
