{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,
		"types": [],
		"rootDir": "src",
		"outDir": "out"
	},
	"include": ["src/**/*"]
}
