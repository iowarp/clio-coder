{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "corpus-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": [],
		"paths": {
			"corpus-jsx/jsx-runtime": ["./src/jsx-runtime.ts"]
		}
	},
	"include": ["src/**/*"]
}
