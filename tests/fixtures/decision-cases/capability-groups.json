{
	"description": "Needs labeled against the gateway's action-class categories for the relevance cluster moment: does a group's stated purpose cover the need. Each case labels only groups where the answer is clear, one group true and clearly unrelated groups false. Purposes are ACTION_CLASS_PURPOSE in src/tools/gateway/index.ts. Split: a case with no split field or split fit is in the fit split; split holdout was written before any score on it was seen and is scored once against cuts chosen on fit. New cases alternate fit and holdout within each authored class.",
	"site": "relevanceClusters",
	"use": "capabilities",
	"groups": [
		{
			"id": "read",
			"label": "read capabilities",
			"purpose": "Inspect files, workspace state, services or external sources without changing them."
		},
		{
			"id": "write",
			"label": "write capabilities",
			"purpose": "Create or change files inside the workspace."
		},
		{
			"id": "execute",
			"label": "execute capabilities",
			"purpose": "Run commands, programs or external actions whose effects depend on what they run."
		},
		{
			"id": "dispatch",
			"label": "dispatch capabilities",
			"purpose": "Start, steer or collect worker agents."
		},
		{
			"id": "system_modify",
			"label": "system_modify capabilities",
			"purpose": "Change machine, harness or settings state outside the workspace."
		},
		{
			"id": "destructive",
			"label": "destructive capabilities",
			"purpose": "Delete or irreversibly change external state."
		},
		{
			"id": "git_destructive",
			"label": "git_destructive capabilities",
			"purpose": "Rewrite or discard version control history or uncommitted work."
		}
	],
	"cases": [
		{
			"query": "read a file",
			"task": "check what the config says",
			"expect": {
				"read": true,
