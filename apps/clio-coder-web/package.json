{
	"name": "@iowarp/clio-coder-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node --import tsx server/main.ts",
		"dev:server": "node --watch --import tsx server/main.ts --port 4317",
		"dev:client": "vite --host 127.0.0.1",
		"build": "vite build",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
		"lint": "biome check .",
		"test": "node --import tsx --import ./tests/harness/no-network.ts --test tests/*.test.ts",
		"openapi": "node --import tsx scripts/openapi.ts && biome format --write contracts/openapi.json",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@tanstack/react-query": "5.102.8",
		"hono": "4.13.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.3.1",
		"typebox": "1.3.0"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "13.0.0",
		"@types/node": "24.12.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	}
}
