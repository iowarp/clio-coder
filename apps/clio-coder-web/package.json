{
	"name": "@iowarp/clio-coder-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node --import tsx server/main.ts",
		"dev:server": "node --watch --import tsx server/main.ts --port 4317",
		"dev:client": "vite --host 127.0.0.1",
		"build": "vite build",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
		"lint": "biome check .",
		"test": "node --import tsx --import ./tests/harness/no-network.ts --test --test-concurrency=2 tests/http-meta.test.ts tests/session-controls.test.ts tests/sessions-http.test.ts tests/worker-rpc.test.ts tests/egress-policy.test.ts tests/process-policy.test.ts tests/boundaries.test.ts tests/kill-parent.test.ts",
		"openapi": "node --import tsx scripts/openapi.ts && biome format --write contracts/openapi.json",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run test:full && pnpm run build && pnpm run smoke:browser",
		"test:acp-real": "node --import tsx --test tests/real/acp.test.ts",
		"smoke:browser": "node --import tsx scripts/browser-smoke.ts",
		"test:pwa": "node --import tsx --test tests/real/background-pwa.test.ts",
		"test:full": "node --import tsx --import ./tests/harness/no-network.ts --test tests/*.test.ts tests/*.test.tsx"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@fontsource/commit-mono": "5.3.0",
		"@hono/node-server": "2.1.1",
		"@tanstack/react-query": "5.102.8",
		"dompurify": "3.4.14",
		"hono": "4.13.5",
		"marked": "18.0.11",
		"mermaid": "11.17.2",
		"prismjs": "1.30.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.3.1",
		"typebox": "1.3.0"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "13.0.0",
		"@axe-core/playwright": "4.13.0",
		"@types/node": "24.12.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"playwright-core": "1.62.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	}
}
