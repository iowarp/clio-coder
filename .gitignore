# Paths listed here never belong in the repository. `git add -f` still stages
# them, so `pnpm run lint` (check-hygiene tracked-ignored) fails when any tracked
# path matches a rule, and `pnpm run hooks:install` adds pre-commit and pre-push
# guards that refuse them before a commit or push leaves the machine.

# Dependencies and build output.
node_modules/
dist/
coverage/
.tsbuildinfo
__pycache__/
*.pyc
*.log
# npm pack output. Verifying an installed tarball is routine; committing one is not.
*.tgz

# Local environment, OS and editor files.
.env
.env.local
.DS_Store

# Agent and tool state. Agent handbooks (AGENTS.md, CLAUDE.md, CLIO-CODER.md) stay
# local everywhere in the tree and are never tracked.
.claude/
.clio-coder/
.clio/
.clio-agent/
.codex
.antigravitycli
CLIO-CODER.md
CLAUDE.md
AGENTS.md

# Private development material: plans, prompts, specs, references, audits,
# handoffs, sprint and release notes, benchmark captures. .mine/ is the home
# for material worth keeping; .superpowers/ is its retired predecessor.
.mine/
.superpowers/
/benchmarks/
/social-campaigns/
/scripts/orch/
/docs/process/
/docs/issues/
/docs/findings/
/docs/sprints/
/docs/release-notes/
/apps/*/notes/
*HANDOFF*.md
/CODEX_*.md
/ROOT-CAUSE.md
/STATUS.md
/DEVLOG.md
/ROADMAP.md

# Throwaway scratch: probe scripts, fixtures, copied repositories.
/tmp/

# Maintainer benchmarks, live probes and their private inputs/coverage.
/scripts/bench-boot.ts
/scripts/bench-harness-context.ts
/scripts/bench-welcome.ts
/scripts/harness-probe.ts
/scripts/smoke-real-home.sh
/scripts/verify-portable-hosts.sh
/tests/contracts/harness-probe.test.ts
/tests/extended/real-home-smoke-isolation.test.ts
/assets/recordings/gui-calibration-master.webm
/tests/fixtures/harness-probes/capability.json
/tests/fixtures/harness-probes/focused.json
/tests/fixtures/harness-probes/independent-areas.json
/tests/fixtures/harness-probes/orientation.json
/tests/fixtures/harness-probes/session-facts.json
/tests/fixtures/harness-probes/undecided.json
