{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:clio-coder:schema:run-result:3",
	"title": "clio-coder run result (schema v3)",
	"description": "The one document `run --output-format json` prints, and the last line (`run_end`) of `run --output-format stream-json`. Source of truth: RunResultEnvelopeV2 in src/cli/modes/run-json-schema-v2.ts.",
	"type": "object",
	"required": [
		"type",
		"schemaVersion",
		"mode",
		"pid",
		"cwd",
		"clioCoderVersion",
		"startedAt",
		"endedAt",
		"durationMs",
		"exitCode",
		"outcome",
		"causes",
		"result",
		"verify",
		"dispatch",
		"timings"
	],
	"properties": {
		"type": { "const": "run_end" },
		"schemaVersion": { "const": 3 },
		"mode": { "enum": ["main", "agent"] },
		"runId": { "type": "string" },
		"sessionId": { "type": "string" },
		"parentSessionId": { "type": "string" },
		"agentId": { "type": "string" },
		"pid": { "type": "integer" },
		"cwd": { "type": "string" },
		"clioCoderVersion": { "type": "string" },
		"startedAt": { "type": "string", "format": "date-time" },
		"endedAt": { "type": "string", "format": "date-time" },
		"durationMs": { "type": "number", "minimum": 0 },
		"exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
		"outcome": { "enum": ["succeeded", "failed", "canceled", "timed_out", "previewed", "displayed"] },
		"outcomeDetail": { "$ref": "#/$defs/causeCode" },
		"causes": {
			"description": "Every fact about how the run ended, winner first; the winner sets exitCode.",
			"type": "array",
			"items": { "$ref": "#/$defs/cause" }
		},
		"completion": {
			"description": "How the run ended as the host sealed it, never read from the answer text. A main run: the claim its agent declared through finish and the host's assessment; --exit-code maps a partly_done or not_done state on an exit-0 run to 1. With --agent: read from the worker's sealed receipt, where a done over a refused execute call that left the run unverified is partly_done (fact refused_check); --exit-code does not read it.",
			"type": "object",
			"required": ["declared", "claimed", "assessed", "state", "limitations", "unverified"],
			"properties": {
				"declared": { "type": "boolean" },
				"claimed": { "enum": ["done", "partly_done", "not_done", null] },
				"assessed": { "enum": ["done", "partly_done", "not_done", "unknown"] },
				"state": { "enum": ["done", "partly_done", "not_done", "unknown"] },
				"facts": {
					"type": "array",
					"items": {
						"enum": [
							"unvalidated_mutation",
							"failed_check",
							"uncollected_run",
							"open_task",
							"observation_budget",
							"refused_check"
						]
					}
				},
				"limitations": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["what", "why"],
						"properties": { "what": { "type": "string" }, "why": { "type": "string" } }
					}
				},
				"unverified": { "type": "array", "items": { "type": "string" } },
				"remaining": { "type": "array", "items": { "type": "string" } }
			}
		},
		"result": {
			"type": "object",
			"required": ["text", "artifacts"],
			"properties": {
				"text": { "type": "string" },
				"artifacts": { "type": "array", "items": { "type": "string" } },
				"structured": { "type": "object", "description": "Present only with --output-schema or output.schema." },
				"enforcedBy": { "enum": ["host", "host+provider"] }
			}
		},
		"route": { "$ref": "#/$defs/route" },
		"usage": {
			"type": "object",
			"description": "RunCallUsage folds (src/domains/dispatch/run-call-usage.ts): every quantity a FactSum, cost a PricingSum. Each scope's `economics`, when a read model folded its calls, is the economy projection of the same calls (EconomyProjectionSchema in src/core/telemetry/economy.ts, version 1): extra user cost, API equivalent, seat credits and energy, without period fees.",
			"required": ["main"],
			"properties": {
				"main": { "$ref": "#/$defs/usageScope" },
				"children": { "$ref": "#/$defs/usageScope" },
				"side": { "$ref": "#/$defs/usageScope" },
				"total": { "$ref": "#/$defs/usageScope" }
			}
		},
		"tools": {
			"type": "object",
			"required": ["calls", "refused", "writes"],
			"properties": {
				"calls": { "type": "integer", "minimum": 0 },
				"refused": { "type": "integer", "minimum": 0 },
				"writes": { "type": "integer", "minimum": 0 }
			}
		},
		"safety": {
			"type": "object",
			"required": ["decisions", "blockedAttempts"],
			"properties": {
				"decisions": {
					"type": "object",
					"required": ["allowed", "blocked", "guardBlocked", "permissionRequested"],
					"properties": {
						"allowed": { "type": "integer", "minimum": 0 },
						"blocked": { "type": "integer", "minimum": 0 },
						"guardBlocked": { "type": "integer", "minimum": 0 },
						"permissionRequested": { "type": "integer", "minimum": 0 }
					}
				},
				"blockedAttempts": { "type": "array" }
			}
		},
		"verify": {
			"type": "object",
			"required": ["requested", "checks"],
			"properties": {
				"requested": { "type": "integer", "minimum": 0 },
				"checks": { "type": "array", "items": { "$ref": "#/$defs/verifyCheck" } }
			}
		},
		"dispatch": {
			"type": "object",
			"required": ["runs", "live", "undelivered"],
			"properties": {
				"runs": {
					"description": "A main run: every child run the main agent dispatched, retried attempts included, oldest first; a run the agent canceled through steer reads outcome canceled. With --agent: the one sealed receipt.",
					"type": "array",
					"items": { "$ref": "#/$defs/dispatchedRun" }
				},
				"live": { "type": "array", "items": { "type": "object" } },
				"undelivered": { "type": "array", "items": { "type": "object" } },
				"superseded": { "type": "array", "items": { "type": "object" } }
			}
		},
		"timings": {
			"type": "object",
			"properties": {
				"sessionReadyMs": { "type": "number" },
				"firstRequestMs": { "type": "number" },
				"firstTokenMs": { "type": "number" }
			}
		},
		"limits": {
			"type": "object",
			"required": ["requested", "enforced"],
			"properties": {
				"requested": {
					"type": "object",
					"properties": {
						"maxCostUsd": { "type": "number" },
						"maxRequests": { "type": "integer" },
						"maxToolCalls": { "type": "integer" },
						"timeoutSeconds": { "type": "number" },
						"requirePriced": { "const": true }
					}
				},
				"enforced": { "type": "array", "items": { "type": "string" } },
				"cost": {
					"type": "object",
					"properties": {
						"overshootPossible": { "const": true },
						"unpricedCalls": { "type": "integer" },
						"unpricedRoutes": { "type": "array", "items": { "type": "string" } }
					}
				}
			}
		},
		"plan": { "type": "object", "description": "--dry-run only (outcome previewed): what the run would do." }
	},
	"$defs": {
		"causeCode": {
			"enum": [
				"interrupted",
				"deadline",
				"reader_closed",
				"unknown_flag",
				"flag_conflict",
				"empty_task",
				"task_file_conflict",
				"task_flag_conflict",
				"task_authority",
				"not_configured",
				"schema_unsupported",
				"session_live",
				"io",
				"not_started",
				"unscripted",
				"permission_required",
				"judge_streak",
				"session_cost_ceiling",
				"max_cost_usd",
				"autonomous_cap",
				"max_requests",
				"max_tool_calls",
				"provider_error",
				"context_overflow",
				"no_answer",
				"output_limit",
				"schema_mismatch",
				"verify_failed",
				"quality_failed",
				"verdict_failed",
				"noop",
				"limitation",
				"dispatched_worker_failed",
				"worker_failed",
				"output_write_failed",
				"run_failed"
			]
		},
		"cause": {
			"type": "object",
			"required": ["code"],
			"properties": {
				"code": { "$ref": "#/$defs/causeCode" },
				"message": { "type": "string" },
				"refusal": { "$ref": "#/$defs/budgetRefusal" }
			}
		},
		"usageScope": {
			"type": "object",
			"properties": {
				"economics": {
					"type": "object",
					"required": ["version", "total", "fees", "cash", "groups", "references", "sources"],
					"properties": { "version": { "const": 1 } }
				}
			}
		},
		"budgetRefusal": {
			"description": "On a max_cost_usd or session_cost_ceiling cause: the ceiling's limit and the route-price spend it was measured against, the calls and routes that spend could not price, and the knob that moves the limit.",
			"type": "object",
			"required": ["reason", "basis", "unknowns", "remedy"],
			"properties": {
				"reason": { "enum": ["run_cost_ceiling", "session_cost_ceiling"] },
				"basis": {
					"type": "object",
					"required": ["metric", "scope", "limitUsd", "runSpent"],
					"properties": {
						"metric": { "const": "route-price-usd" },
						"scope": { "enum": ["run", "session"] },
						"limitUsd": { "type": ["number", "null"] },
						"runSpent": { "type": ["object", "null"], "description": "This run's FactSum of route-price USD." }
					}
				},
				"unknowns": {
					"type": "object",
					"required": ["unpricedCalls", "unpricedRoutes"],
					"properties": {
						"unpricedCalls": { "type": "integer", "minimum": 0 },
						"unpricedRoutes": { "type": "integer", "minimum": 0 }
					}
				},
				"remedy": {
					"type": "object",
					"properties": { "flag": { "const": "--max-cost-usd" }, "setting": { "const": "safety.limits.sessionCostUsd" } }
				}
			}
		},
		"route": {
			"type": "object",
			"properties": {
				"target": { "type": "string" },
				"model": { "type": "string" },
				"thinking": { "type": "string" }
			}
		},
		"verifyCheck": {
			"type": "object",
			"required": ["command", "status"],
			"properties": {
				"id": { "type": "string" },
				"command": { "type": "string" },
				"status": { "enum": ["passed", "failed", "timed_out", "skipped"] },
				"reason": { "enum": ["interrupted", "deadline", "turn_failed"] },
				"exitCode": { "type": "integer" },
				"durationMs": { "type": "number" },
				"ranAfterLastEdit": { "type": "boolean" }
			}
		},
		"dispatchedRun": {
			"type": "object",
			"required": ["runId", "agentId"],
			"properties": {
				"runId": { "type": "string" },
				"agentId": { "type": "string" },
				"outcome": {
					"type": "string",
					"description": "The run's terminal outcome; absent for a run still live when waiting stopped."
				},
				"outcomeCode": { "type": ["string", "null"] },
				"outcomeDetail": { "type": ["string", "null"] },
				"safety": {
					"description": "A main run's dispatched run: the sealed capability envelope its run journal settled with, staticHead included; absent when it has none.",
					"type": "object",
					"properties": { "envelope": { "type": "object" } }
				}
			}
		}
	}
}
