{
	"description": "Example fleet config for public benchmark adapters. Keep the real fleet.json untracked or point CLIO_CODER_FLEET at a private file.",
	"default": "local-split",
	"predictionModelName": "clio-coder-example",
	"profiles": {
		"local-single": {
			"description": "One endpoint serves both orchestrator and workers.",
			"orchestrator": {
				"target": "local-main",
				"runtime": "llamacpp",
				"url": "http://orchestrator.example:8080",
				"model": "example-coder-model",
				"thinking": "off"
			},
			"workers": {
				"target": "local-main",
				"runtime": "llamacpp",
				"url": "http://orchestrator.example:8080",
				"model": "example-coder-model",
				"thinking": "off"
			}
		},
		"local-split": {
			"description": "Separate endpoints for orchestrator and worker runs.",
			"orchestrator": {
				"target": "local-main",
				"runtime": "llamacpp",
				"url": "http://orchestrator.example:8080",
				"model": "example-orchestrator-model",
				"thinking": "off"
			},
			"workers": {
				"target": "local-worker",
				"runtime": "lmstudio-native",
				"url": "http://worker.example:1234",
				"model": "example-worker-model",
				"thinking": "off"
			}
		},
		"cloud-claude": {
			"description": "Example cloud profile using stored operator credentials.",
			"orchestrator": {
				"target": "anthropic-max",
				"runtime": "anthropic-max",
				"model": "claude-opus-4-8",
				"thinking": "medium"
			},
			"workers": {
				"target": "anthropic-max",
				"runtime": "anthropic-max",
				"model": "claude-sonnet-5",
				"thinking": "medium"
			}
		},
		"cloud-openai": {
			"description": "Example OpenAI profile using stored operator credentials.",
			"orchestrator": {
				"target": "openai-codex",
				"runtime": "openai-codex",
				"model": "gpt-5.5",
				"thinking": "medium"
			},
			"workers": {
				"target": "openai-codex",
				"runtime": "openai-codex",
				"model": "gpt-5.5",
				"thinking": "medium"
			}
		}
	}
}
